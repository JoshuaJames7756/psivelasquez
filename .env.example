# Copiar a .env.local para desarrollo. En producción, configurar
# estas mismas variables en Vercel → Project Settings → Environment Variables.

# Neon — connection string del proyecto (Dashboard → Connection Details)
DATABASE_URL=

# Clerk — Dashboard → API Keys
# Publishable key: usada en frontend (React) y en verificación backend
CLERK_PUBLISHABLE_KEY=
# Secret key: SOLO backend, nunca exponer en frontend
CLERK_SECRET_KEY=

# Igual a CLERK_PUBLISHABLE_KEY de arriba, pero con prefijo VITE_ —
# Vite solo expone al frontend las variables que empiezan con VITE_.
VITE_CLERK_PUBLISHABLE_KEY=

# Cloudinary — Dashboard → Settings → API Keys. SOLO backend (usadas
# para firmar subidas), nunca expuestas al frontend directamente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SEGURIDAD: IDs de Clerk (Dashboard → Users → usuario → "User ID") de las
# personas autorizadas a entrar al panel, separados por coma. Si falta o está
# vacía, el panel rechaza a todos. Sin esto, cualquier persona registrada en
# Clerk podría ver los datos de los pacientes.
ADMIN_USER_IDS=

# Opcional (recomendado): orígenes que pueden usar el token de sesión,
# separados por coma. Ej: https://www.midominio.com,https://psivelasquez.vercel.app
AUTHORIZED_PARTIES=

# Opcional: secreto para proteger el cron (Vercel lo envía como Bearer).
CRON_SECRET=

# Opcional: dominio público definitivo (SEO). Ej: https://www.midominio.com
VITE_SITE_URL=
